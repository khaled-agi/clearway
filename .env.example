# ---- AI model -------------------------------------------------------------
# Pick one. Leave all empty to run on built-in rules + simulated extraction.
#
# Groq (cloud, very fast, free tier, nothing to install) — create a key at https://console.groq.com/keys
# LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Local (private, free, nothing leaves your machine) — install Ollama from https://ollama.com, then:
#   ollama pull qwen2.5:14b            (or qwen2.5:7b on a laptop with <16 GB RAM)
#   ollama pull qwen2.5vl:7b           (optional: lets ClearWay read photos/scans of documents)
LLM_PROVIDER=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_FAST_MODEL=
OLLAMA_VISION_MODEL=

# Any OpenAI-compatible local server (LM Studio, llama.cpp server, vLLM, LocalAI):
# LLM_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=
OPENAI_VISION_MODEL=
OPENAI_API_KEY=

# Claude (cloud; adds web-searched, sourced assessments):
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

PORT=3000

# ---- Optional freight-rate integrations (empty = built-in lane estimate) ----
FREIGHTOS_API_KEY=
MAERSK_CLIENT_ID=
MAERSK_CLIENT_SECRET=
FLEXPORT_API_KEY=
SHIPPO_API_KEY=
