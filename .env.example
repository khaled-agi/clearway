# Copy to .env and fill in to enable real document extraction with Claude.
# Without a key the app runs in simulated mode (full UI, fake extraction).
ANTHROPIC_API_KEY=
# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000

# Optional freight-rate integrations (leave empty to use the built-in lane estimate)
FREIGHTOS_API_KEY=
MAERSK_CLIENT_ID=
MAERSK_CLIENT_SECRET=
FLEXPORT_API_KEY=
SHIPPO_API_KEY=
